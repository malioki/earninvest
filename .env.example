# ─── Mode ────────────────────────────────────────────────────
# true = demo data (no real API keys needed), false = real mode
DEMO_MODE=true

# ─── Binance ─────────────────────────────────────────────────
# Needs "Read" + "Spot & Margin Trading" (for subscribe/redeem)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── HTX (Huobi) ─────────────────────────────────────────────
# Needs "Read" + "Trade" permissions
HTX_API_KEY=
HTX_API_SECRET=
HTX_ACCOUNT_ID=

# ─── Bybit ───────────────────────────────────────────────────
# Public endpoints (products, prices) work without a key.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ─── Telegram ────────────────────────────────────────────────
# Create bot via @BotFather, get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Who may log cash expenses through the bot — comma-separated Telegram user ids.
# Anyone else is silently ignored. Send /id to the bot to learn an id.
# Leave empty and only TELEGRAM_CHAT_ID is trusted.
TELEGRAM_ALLOWED_IDS=

# ─── Scheduler (cron syntax) ─────────────────────────────────
CHECK_CRON=0 */6 * * *
REPORT_CRON=0 9 * * *

# ─── Web ─────────────────────────────────────────────────────
PORT=3000

# ─── Optimizer ───────────────────────────────────────────────
STABLECOIN_ASSETS=USDT,USDC,FDUSD,USD1
# Min USDT worth rebalancing (below this – not worth network fees)
MIN_REBALANCE_AMOUNT=20
HIGH_APY_THRESHOLD=0.035

# greedy = all into the best rate; diversified = spread across top N products
STRATEGY=diversified
DIV_MIN_PRODUCTS=4
DIV_MAX_PER_PRODUCT=0.4
DIV_MAX_PER_EXCHANGE=0.6

# ─── Volatile coin earn (optional, higher risk) ──────────────
VOLATILE_EARN_ENABLED=true
VOLATILE_MAX_PCT=0.1
VOLATILE_MAX_PER_COIN=0.03
VOLATILE_STOP_LOSS=0.005
VOLATILE_MIN_APY=0.1
PRICE_CHECK_CRON=*/15 * * * *
