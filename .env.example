# ─── Mode ────────────────────────────────────────────────────
# true = demo data (no real API keys needed), false = real mode
DEMO_MODE=true

# ─── Binance ─────────────────────────────────────────────────
# Needs "Read" + "Spot & Margin Trading" (for subscribe/redeem)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── HTX (Huobi) ─────────────────────────────────────────────
# Needs "Read" + "Trade" permissions
HTX_API_KEY=
HTX_API_SECRET=
HTX_ACCOUNT_ID=

# ─── Telegram ────────────────────────────────────────────────
# Create bot via @BotFather, get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Who may log cash expenses through the bot — comma-separated Telegram user ids.
# Anyone else is silently ignored. Send /id to the bot to learn an id.
# Leave empty and only TELEGRAM_CHAT_ID is trusted.
TELEGRAM_ALLOWED_IDS=

# ─── Scheduler (cron syntax) ─────────────────────────────────
CHECK_CRON=0 */6 * * *
REPORT_CRON=0 9 * * *

# ─── Web ─────────────────────────────────────────────────────
PORT=3000

# ─── Optimizer ───────────────────────────────────────────────
# Min USDT worth rebalancing (below this – not worth network fees)
MIN_REBALANCE_AMOUNT=20

# ─── Bybit ───────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ─── Family app ──────────────────────────────────────────────
# Who sees 💼 Финансы and gets payment reminders (default: everyone in ALLOWED_IDS)
TELEGRAM_FINANCE_IDS=
# Public links the two apps use to point at each other
FAMILY_URL=
EARN_URL=
# Earn dashboard port (default: PORT + 1)
EARN_PORT=

# ─── AI (receipt photos, /ask) ───────────────────────────────
ANTHROPIC_API_KEY=

# ─── Backup ──────────────────────────────────────────────────
# data/ is not in git: the bot zips it weekly to everyone who sent /backup,
# plus these ids (comma-separated)
TELEGRAM_BACKUP_IDS=
BACKUP_CRON=0 21 * * 0
